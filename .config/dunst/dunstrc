[global]

### General ##

    monitor = 0
    follow = keyboard
    width = 450
    height = (0, 300)
    origin = top-right
    offset = (16, 16)
    scale = 0
    notification_limit = 20

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 0
    progress_bar_corners = all

### Look ###

    icon_corner_radius = 0
    icon_corners = all
    indicate_hidden = yes
    transparency = 0

    padding = 12
    gap_size = 8
    horizontal_padding = 10
    text_icon_padding = 12

    separator_height = 5
    frame_width = 2
    background = "#00172Ecc"
    foreground = "#FFF1DA"
    frame_color = "#FFF1DA"

    separator_color = frame
    sort = yes
    # idle_threshold = 120

### Text  ###

    font = Adwaita Sans 12
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle

    ignore_newline = no
    stack_duplicates = false
    hide_duplicate_count = false
    show_indicators = no
    enable_posix_regex = false

### Icons ###

    enable_recursive_icon_lookup = false
    icon_theme = Papirus
    icon_position = left
    min_icon_size = 42
    max_icon_size = 64
    icon_path = /usr/share/icons/Papirus/48x48/apps/:/usr/share/icons/Papirus/48x48/status/

### History ###

    sticky_history = yes
    history_length = 20

### Misc/Advanced ###

    dmenu = rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 0
    corners = all
    ignore_dbusclose = false

### Wayland ###

    layer = top
    force_xwayland = false

### Legacy

    force_xinerama = false

### Mouse

    mouse_left_click = do_action
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    timeout = 6
    default_icon = preferences-desktop-notification

[urgency_normal]
    timeout = 6
    override_pause_level = 30
    default_icon = preferences-desktop-notification

[urgency_critical]
    timeout = 6
    override_pause_level = 60
    default_icon = gnome-warning

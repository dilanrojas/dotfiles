# ----------------
# --- MONITORS ---
# ----------------

output eDP-1 {
    scale 1
    adaptive_sync off
    allow_tearing on
    scale_filter linear
    position 0,0
    max_render_time off
}

output HDMI-A-I {
  scale 1
  allow_tearing off
  position 1920,0
}

workspace 1 output eDP-1
workspace 2 output eDP-1
workspace 3 output eDP-1
workspace 4 output eDP-1
workspace 5 output HDMI-A-I
workspace 6 output HDMI-A-I
workspace 7 output HDMI-A-I
workspace 8 output HDMI-A-I
workspace 9 output HDMI-A-I
workspace 10 output HDMI-A-I

# -------------
# --- LOOKS -- 
# -------------

# Wallpaper
output * bg ~/Pictures/wallpapers/237.jpg fill

# Borders
default_border pixel 2
default_floating_border pixel 2

# Gaps
gaps outer 0
gaps inner 10

# smart_gaps on
# smart_borders on

for_window [app_id="Alacritty"] blur enable
for_window [app_id="float"] blur enable

# Theme Colors
set $color_bg_primary        #1d1d20
set $color_bg_secondary      #222226
set $color_bg_tertiary       #232326
set $color_bg_muted          #353538

set $color_fg_primary        #ffffff
set $color_fg_secondary      #cccccc
set $color_fg_muted          #aaaaaa

set $color_accent            #d79921

set $color_inactive          #1d2021

set $alpha_inactive          ff
set $alpha_active            ff

set $active_border           $color_accent$alpha_active
set $active_border_indicator $color_accent$alpha_active
set $inactive_border         $color_inactive$alpha_inactive

set $color_border_muted      #504945
set $color_urgent            #3b2626

# class                 border                  background              text                    indicator                  child_border
client.focused          $active_border          $active_border          $color_bg_primary       $active_border_indicator   $active_border
client.focused_inactive $color_bg_secondary     $color_bg_secondary     $color_fg_muted         $color_bg_muted            $color_bg_secondary
client.unfocused        $inactive_border        $color_bg_tertiary      $color_fg_muted         $inactive_border           $inactive_border
client.urgent           $color_urgent           $color_bg_primary       $active_border          $color_urgent              $color_urgent
client.placeholder      $color_bg_tertiary      $color_bg_tertiary      $color_fg_muted         $color_bg_tertiary         $color_bg_tertiary

client.background       $color_bg_primary

# ------------------------
# --- SwayFX exclusive ---
# ------------------------

corner_radius 0

shadows disable
shadow_blur_radius 15
shadow_color #00000070
shadow_offset 0 0

default_dim_inactive 0

blur disable
blur_passes 2
blur_radius 6
blur_noise 0.02
blur_brightness 1.0
blur_contrast 1.02
blur_saturation 1.1
blur_xray disable

for_window [app_id="Alacritty"] blur enable
for_window [app_id="float"] blur enable

layer_effects "rofi" {
    blur enable
    blur_ignore_transparent enable
}

layer_effects "waybar" {
    blur enable
    blur_ignore_transparent enable
}

layer_effects "notifications" {
    blur enable
    blur_ignore_transparent enable
}

layer_effects "swayosd" {
    blur enable
    blur_ignore_transparent enable
}

# ----------------
# -- VARIABLES ---
# ----------------

set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term alacritty
set $menu rofi -show drun
set $browser brave
set $files nautilus -w
set $screenshot ~/.config/sway/scripts/screenshot.sh
set $cropscreenshot ~/.config/sway/scripts/cropscreenshot.sh
set $colorpicker ~/.config/sway/scripts/hyprpicker.sh
set $reload ~/.config/sway/scripts/reload.sh
set $clipboard cliphist list | rofi -dmenu | cliphist decode | wl-copy
set $dnd ~/.config/sway/scripts/dnd.sh
set $power_profile ~/.config/sway/scripts/power_profile.sh

# ----------------
# --- MONITORS ---
# ----------------

# output DP-1 mode 1920x1080@100.0Hz position 0,0
# output eDP-1 resolution 1366x768 position 0,0
# output HDMI-A-1 resolution 1920x1080 position 1920,0

# -----------------
# --- AUTOSTART ---
# -----------------

# exec swayidle -w \
#     timeout 300 'brightnessctl set 30%' \
#     timeout 600 'brightnessctl set 0%' resume 'brightnessctl set 100%' \
#     before-sleep 'brightnessctl set 0%'

exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec mpris-proxy
exec swayosd-server
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec swaync
exec bash ~/.config/sway/scripts/low_battery.sh

exec_always wmname LG3D

exec systemctl --user start --ignore-dependencies xdg-desktop-portal

exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP /usr/lib/xdg-desktop-portal-gnome

# -------------
# --- INPUT ---
# -------------

input type:touchpad {
  tap enabled
  drag_lock disabled
  dwt enabled
  natural_scroll enabled
  accel_profile adaptive
}

input type:pointer {
  accel_profile flat
}

input type:keyboard {
    xkb_layout "us,latam"
}

# -------------
# --- LOOKS -- 
# -------------

# Wallpaper
output * bg ~/Pictures/wallpapers/135.jpg fill

# Borders
default_border pixel 1
default_floating_border pixel 1

# Gaps
gaps inner 5
# smart_gaps on

# Theme Colors
set $color_bg_primary        #1d1d20
set $color_bg_secondary      #222226
set $color_bg_tertiary       #232326
set $color_bg_muted          #353538

set $color_fg_primary        #fbf1c7
set $color_fg_secondary      #ebdbb2
set $color_fg_muted          #a89984

set $color_accent            #37373b
set $color_accent_active     #424245

set $color_border_muted      #504945
set $color_urgent            #3b2626

# class                 border                  background              text                    indicator               child_border
client.focused          $color_accent           $color_accent           $color_bg_primary       $color_accent_active    $color_accent
client.focused_inactive $color_bg_secondary     $color_bg_secondary     $color_fg_muted         $color_bg_muted         $color_bg_secondary
client.unfocused        $color_bg_tertiary      $color_bg_tertiary      $color_fg_muted         $color_bg_secondary     $color_bg_tertiary
client.urgent           $color_urgent           $color_bg_primary       $color_accent           $color_urgent           $color_urgent
client.placeholder      $color_bg_tertiary      $color_bg_tertiary      $color_fg_muted         $color_bg_tertiary      $color_bg_tertiary

client.background       $color_bg_primary

# -------------------
# --- KEYBINDINGS ---
# -------------------

bindsym $mod+Return exec $term
bindsym $mod++q kill
bindsym $mod+m exec $menu
bindsym $mod+b exec $browser
bindsym $mod+e exec $files
bindsym $mod+p exec $colorpicker
bindsym $mod+Shift+b exec alacritty --class float -e bluetui
bindsym $mod+v exec $clipboard
bindsym $mod+n exec $dnd
bindsym $mod+Shift+p exec $power_profile

floating_modifier $mod normal
bindsym $mod+space input "type:keyboard" xkb_switch_layout next

bindsym $mod+Shift+r exec $reload
bindsym $mod+Shift+q exec wlogout

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+Shift+n splith
bindsym $mod+Shift+v splitv

bindsym $mod+o layout tabbed
bindsym $mod+i layout toggle split

bindsym $mod+f fullscreen

bindsym $mod+Shift+f floating toggle

bindsym $mod+w focus mode_toggle

bindsym $mod+a focus parent

bindsym $mod+Shift+u move scratchpad

bindsym $mod+u scratchpad show

bindsym $mod+Control+$left resize shrink width 50px
bindsym $mod+Control+$right resize grow width 50px
bindsym $mod+Control+$up resize grow height 50px
bindsym $mod+Control+$down resize shrink height 50px

set $osd swayosd-client --monitor "$(swaymsg -t get_outputs | jq -r '.[] | select(.focused == true).name')"

bindsym XF86AudioMute exec $osd --output-volume mute-toggle
bindsym XF86AudioLowerVolume exec $osd --output-volume lower
bindsym XF86AudioRaiseVolume exec $osd --output-volume raise
bindsym XF86AudioMicMute exec $osd --input-volume mute-toggle
bindsym XF86MonBrightnessDown exec $osd --brightness lower
bindsym XF86MonBrightnessUp exec $osd --brightness raise

bindsym Print exec $cropscreenshot
bindsym $mod+Print exec $screenshot
bindsym $mod+s exec $cropscreenshot
bindsym $mod+Shift+s exec $screenshot

# -------------
# --- RULES ---
# -------------

mouse_warping container
focus_follows_mouse yes
for_window [app_id="float"] floating enable
for_window [app_id="lunarclient"] floating enable
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable
for_window [app_id="brave" title=".*wants to save.*"] floating enable, move position center
for_window [app_id="steam"] floating enable

# ----------
# -- BAR ---
# ----------

bar {
  swaybar_command waybar
}

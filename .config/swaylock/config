# Enable fingerprint/PAM feedback
indicator
indicator-radius=100
indicator-thickness=7

# Take a screenshot of the current workspace and blur it
screenshots
effect-blur=5x10
effect-vignette=0

# Clock display
clock
timestr=%R
datestr=%a, %b %d

# Layout & Typography
font="Adwaita Sans Medium"
font-size=24

# --- Color Palette (Neutral Slate / Charcoal inspired) ---
# Main circle color (Key press highlight)
key-hl-color=abb2bf
bs-hl-color=7f848e

# Inside the circle
inside-color=1e222ab0
inside-clear-color=282c34b0
inside-ver-color=2e323ab0
inside-wrong-color=3e2e30b0

# Ring borders
ring-color=4b5263
ring-clear-color=98c379
ring-ver-color=61afef
ring-wrong-color=e06c75

# Text indicators
text-color=abb2bf
text-clear-color=abb2bf
text-ver-color=61afef
text-wrong-color=e06c75
line-uses-inside

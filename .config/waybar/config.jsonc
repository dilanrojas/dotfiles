// -*- mode: jsonc -*-
{
  "reload_style_on_change": true,
  // "layer": "top",
  // "position": "bottom",
  // "width": 700,
  "fixed-center": false,
  "height": 30,
  "spacing": 0,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-right": [
    "group/tray",
    "custom/separator",
    "group/extra",
    "custom/separator",
    "group/system",
    "custom/separator",
    "clock",
    "custom/dnd"
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "dev",
      "2": "www",
      "3": "img",
      "4": "doc",
      "5": "mda",
      "6": "fls",
      "7": "ter",
      "8": "sys",
      "9": "gfx",
      "10": "kvm"
    },
    "persistent-workspaces": {
      "*": 10,
      "HDMI-A-1": 0
    }
  },
  "hyprland/window": {
    "format": "{}"
  },
  "hyprland/language": {
    "format": "{}",
    "format-en": "US",
    "format-es": "LA",
    "on-click": "hyprctl switchxkblayout all next"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "tooltip": true,
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    }
  },
  "tray": {
    "icon-size": 18,
    "spacing": 16
  },
  "clock": {
    "format": "{:%b %d %I:%M %p}",
    "on-click": "gnome-calendar",
    "tooltip": false
  },
  "battery": {
    "format": "{icon}",
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "interval": 3,
    "tooltip": true,
    "tooltip-format": "{capacity}%",
    "on-click": "bash ~/.config/hypr/scripts/power_profile.sh",
    "on-scroll-up": "bash ~/.config/hypr/scripts/osd.sh brightness increase",
    "on-scroll-down": "bash ~/.config/hypr/scripts/osd.sh brightness decrease",
    "scroll-step": 5
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}",
    "tooltip": true,
    "format-icons": {
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰾆"
    }
  },
  "custom/updates": {
    "format": " {}",
    "return-type": "json",
    "tooltip": true,
    "on-click": "~/.config/hypr/scripts/update_system.sh",
    "exec-if": "which waybar-module-pacman-updates",
    "exec": "waybar-module-pacman-updates --interval-seconds 5 --network-interval-seconds 300"
  },
  "network": {
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)",
    "tooltip-format-ethernet": "Connected",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "alacritty --class float -e wlctl"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pamixer --toggle-mute",
    "on-click-right": "alacritty --class float -e pulsemixer",
    "tooltip": true,
    "tooltip-format": "{volume}%",
    "on-scroll-up": "bash ~/.config/hypr/scripts/osd.sh volume increase",
    "on-scroll-down": "bash ~/.config/hypr/scripts/osd.sh volume decrease",
    "scroll-step": 5
  },
  "custom/dnd": {
    "exec": "~/.config/waybar/scripts/dnd-status.sh",
    "return-type": "json",
    "interval": 30,
    "signal": 8,
    "on-click-right": "~/.config/hypr/scripts/notification_history.sh",
    "on-click": "~/.config/hypr/scripts/dnd.sh",
    "format": "{icon}",
    "format-icons": {
      "dnd-on": "󰂛",
      "dnd-off": "󰂚"
    }
  },
  "custom/nightlight": {
    "exec": "~/.config/waybar/scripts/night-light-status.sh",
    "return-type": "json",
    "interval": 60,
    "signal": 10,
    "on-click": "~/.config/hypr/scripts/night_light.sh",
    "format": "{icon}",
    "format-icons": {
      "night-on": "",
      "night-off": ""
    }
  },
  "custom/menu-trigger": {
    "format": "",
    "tooltip": false
  },
  "custom/screenrecord": {
    "exec": "~/.config/waybar/scripts/screenrecord-status.sh",
    "return-type": "json",
    "interval": 1,
    "signal": 9,
    "on-click": "~/.config/hypr/scripts/screenrecord.sh stop"
  },
  "custom/spotify": {
    "exec": "~/.config/waybar/scripts/spotify-status.sh",
    "return-type": "json",
    "format": "{}",
    "max-length": 20,
    "tooltip": true
  },
  "custom/spotify-prev": {
    "exec": "~/.config/waybar/scripts/spotify-controls.sh prev",
    "return-type": "json",
    "on-click": "playerctl --player spotify previous"
  },
  "custom/spotify-toggle": {
    "exec": "~/.config/waybar/scripts/spotify-controls.sh toggle",
    "return-type": "json",
    "on-click": "playerctl --player spotify play-pause"
  },
  "custom/spotify-next": {
    "exec": "~/.config/waybar/scripts/spotify-controls.sh next",
    "return-type": "json",
    "on-click": "playerctl --player spotify next"
  },
  "group/spotify": {
    "orientation": "horizontal",
    "modules": [
      "custom/spotify",
      "custom/spotify-prev",
      "custom/spotify-toggle",
      "custom/spotify-next"
    ]
  },
  "group/tray": {
    "orientation": "horizontal",
    "modules": [
      "custom/screenrecord",
      "group/spotify",
      "tray",
      "custom/updates"
    ]
  },
  "group/extra": {
    "orientation": "horizontal",
    "modules": [
      "power-profiles-daemon",
      "custom/nightlight",
      "idle_inhibitor",
      "hyprland/language"
    ]
  },
  "group/system": {
    "orientation": "horizontal",
    "modules": [
      "network",
      "pulseaudio",
      "battery"
    ]
  },
  "custom/separator": {
    "format": "|"
  },
  "custom/menu": {
    "format": "󰣇",
    "on-click": "rofi -show drun"
  }
}

// -*- mode: jsonc -*-
{
  // "layer": "top",
  "reload_style_on_change": true,
  // "position": "bottom",
  "height": 32,
  // "width": 1280,
  "spacing": 0,
  "modules-left": [
    "sway/workspaces"
  ],
  "modules-center": [
    "clock",
    "custom/notification"
  ],
  "modules-right": [
    "group/tray-expander",
    "sway/language",
    "sway/scratchpad",
    "network",
    "pulseaudio",
    "battery",
    "custom/power"
  ],
  // Modules configuration
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{icon}",
    "format-icons": {
      "1": "I",
      "2": "II",
      "3": "III",
      "4": "IV",
      "5": "V",
      "6": "VI",
      "7": "VII",
      "8": "VIII",
      "9": "IX",
      "10": "X"
      //"urgent": "",
      // "focused": "O"
    },
    "persistent-workspaces": {
      "1": [
        "eDP-1"
      ],
      "2": [
        "eDP-1"
      ],
      "3": [
        "eDP-1"
      ],
      "4": [
        "eDP-1"
      ],
      "5": [
        "eDP-1"
      ],
      "6": [
        "HDMI-A-1"
      ],
      "7": [
        "HDMI-A-1"
      ],
      "8": [
        "HDMI-A-1"
      ],
      "9": [
        "HDMI-A-1"
      ],
      "10": [
        "HDMI-A-1"
      ]
    }
  },
  "sway/scratchpad": {
    "format": "{icon} {count}",
    "show-empty": false,
    "format-icons": [
      "",
      ""
    ],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "tray": {
    "icon-size": 18,
    "spacing": 16
  },
  "clock": {
    "format": "{:%b %d  %I:%M %p}",
    "on-click-right": "swaync-client -d -sw",
    "on-click": "swaync-client -t -sw",
    "tooltip": false
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "group/expand-icons",
      "tray",
      "custom/updates",
      "power-profiles-daemon"
    ]
  },
  "group/expand-icons": {
    "orientation": "inherit",
    "modules": [
      "custom/expand-icon#horizontal",
      "custom/expand-icon#vertical"
    ]
  },
  "custom/expand-icon#horizontal": {
    "format": "",
    "tooltip": false,
    "on-scroll-up": "",
    "on-scroll-down": "",
    "on-scroll-left": "",
    "on-scroll-right": ""
  },
  "custom/expand-icon#vertical": {
    "format": "",
    "rotate": 270,
    "tooltip": false,
    "on-scroll-up": "",
    "on-scroll-down": "",
    "on-scroll-left": "",
    "on-scroll-right": ""
  },
  "battery": {
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-plugged": "{icon} {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "interval": 3,
    "tooltip": false,
    "tooltip-format": "Battery: {capacity}%",
    "on-click": "echo hey",
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "󰓅",
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰾆"
    }
  },
  "custom/updates": {
    "format": "󰒙 {}",
    "return-type": "json",
    "format-icons": {
      "has-updates": "󱍷",
      "updated": "󰂪"
    },
    "on-click": "alacritty --class float -e bash ~/.config/sway/scripts/update_system.sh",
    "exec-if": "which waybar-module-pacman-updates",
    "exec": "waybar-module-pacman-updates --interval-seconds 5 --network-interval-seconds 300"
  },
  "network": {
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": " ",
    "tooltip-format": "  ",
    "format-linked": "  ",
    "format-disconnected": "󰤮 ",
    "tooltip": false,
    "on-click": "alacritty --class float -e nmtui",
    "format-icons": [
      "󰤯 ",
      "󰤟 ",
      "󰤢 ",
      "󰤥 ",
      "󰤨 "
    ]
  },
  "pulseaudio": {
    "format": "{icon}",
    "on-click": "pamixer --toggle-mute",
    "on-click-right": "pavucontrol",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "custom/separator": {
    "format": "|",
    "tooltip": false
  },
  "custom/power": {
    "format": " ",
    "on-click": "wlogout",
    "tooltip": false
  },
  "custom/menu": {
    "format": "",
    "on-click": "alacritty --class float -e nvim ~/.config/hypr/hyprland.conf",
    "tooltip": false
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "",
      "none": " ",
      "dnd-notification": "",
      "dnd-none": "",
      "inhibited-notification": "",
      "inhibited-none": "",
      "dnd-inhibited-notification": "",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "escape": true
  }
}

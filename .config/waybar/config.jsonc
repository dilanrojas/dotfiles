// -*- mode: jsonc -*-
{
  // "layer": "top",
  "reload_style_on_change": true,
  // "position": "bottom",
  "height": 30,
  // "width": 1280,
  "spacing": 0,
  "modules-left": [
    "sway/workspaces",
    "custom/separator",
    "sway/window"
  ],
  "modules-center": [],
  "modules-right": [
    "tray",
    "sway/scratchpad",
    "custom/updates",
    "sway/language",
    "power-profiles-daemon",
    "custom/separator",
    "network",
    "pulseaudio",
    "battery",
    "custom/separator",
    "clock"
  ],
  // Modules configuration
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{icon}",
    "format-icons": {
      "1": "dev",
      "2": "www",
      "3": "img",
      "4": "doc",
      "5": "box",
      "6": "fls",
      "7": "sys",
      "8": "gfx",
      "9": "dsc",
      "10": "msc"
      //"urgent": "",
      // "focused": "O"
    },
    "persistent-workspaces": {
      "1": [
        "eDP-1"
      ],
      "2": [
        "eDP-1"
      ],
      "3": [
        "eDP-1"
      ],
      "4": [
        "eDP-1"
      ],
      "5": [
        "eDP-1"
      ],
      "6": [
        "eDP-1"
      ],
      "7": [
        "eDP-1"
      ],
      "8": [
        "eDP-1"
      ],
      "9": [
        "eDP-1"
      ],
      "10": [
        "eDP-1"
      ]
    }
  },
  "sway/scratchpad": {
    "format": "pad: {count}",
    "show-empty": false,
    "format-icons": [
      "",
      ""
    ],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },
  "sway/language": {
    "format": "kbd: {}",
    "tooltip": false,
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "tray": {
    "icon-size": 16,
    "spacing": 16
  },
  "clock": {
    "format": "{:%a, %b %d  %I:%M %p}",
    "on-click": "gnome-calendar",
    "tooltip": false
  },
  "battery": {
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "bat: {capacity}%",
    "interval": 3,
    "tooltip": false,
    "on-click": "bash ~/.config/sway/scripts/power_profile.sh",
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  "power-profiles-daemon": {
    "format": "prf: {profile}",
    "tooltip": false
  },
  "custom/updates": {
    "format": "upd: {}",
    "return-type": "json",
    "on-click": "bash ~/.config/sway/scripts/update_system.sh",
    "exec-if": "which waybar-module-pacman-updates",
    "exec": "waybar-module-pacman-updates --interval-seconds 5 --network-interval-seconds 300"
  },
  "network": {
    "format": "net: {signalStrength}%",
    "format-disconnected": "net: none",
    "tooltip": false,
    "on-click": "alacritty --class float -e nmtui"
  },
  "pulseaudio": {
    "format": "vol: {volume}%",
    "format-muted": "vol: 0%",
    "on-click": "pamixer --toggle-mute",
    "on-click-right": "pavucontrol",
    "tooltip": false,
    "scroll-step": 5
  },
  "custom/separator": {
    "format": "⋮",
    "tooltip": false
  }
}

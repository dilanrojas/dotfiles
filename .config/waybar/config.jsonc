// -*- mode: jsonc -*-
{
  // "layer": "top",
  "reload_style_on_change": true,
  // "position": "bottom",
  "height": 30,
  // "width": 1280,
  "spacing": 0,
  "modules-left": [
    "sway/workspaces",
    "custom/separator",
    "sway/window"
  ],
  "modules-center": [],
  "modules-right": [
    "tray",
    "sway/scratchpad",
    "custom/updates",
    "sway/language",
    "custom/separator",
    "network",
    "pulseaudio",
    "power-profiles-daemon",
    "battery",
    "custom/separator",
    "clock"
  ],
  // Modules configuration
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{icon}",
    "format-icons": {
      "1": "DEV",
      "2": "WWW",
      "3": "IMG",
      "4": "FLS",
      "5": "MSC",
      "6": "BOX",
      "7": "SYS",
      "8": "GFX",
      "9": "PFS",
      "10": "EXT"
      //"urgent": "",
      // "focused": "O"
    },
    "persistent-workspaces": {
      "1": [
        "eDP-1"
      ],
      "2": [
        "eDP-1"
      ],
      "3": [
        "eDP-1"
      ],
      "4": [
        "eDP-1"
      ],
      "5": [
        "eDP-1"
      ],
      "6": [
        "eDP-1"
      ],
      "7": [
        "eDP-1"
      ],
      "8": [
        "eDP-1"
      ],
      "9": [
        "eDP-1"
      ],
      "10": [
        "eDP-1"
      ]
    }
  },
  "sway/scratchpad": {
    "format": "pad: {count}",
    "show-empty": false,
    "format-icons": [
      "",
      ""
    ],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },
  "sway/language": {
    "format": "kbd: {}",
    "tooltip": false,
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "tray": {
    "icon-size": 16,
    "spacing": 16
  },
  "clock": {
    "format": "{:%a, %b %d  %I:%M %p}",
    "on-click": "gnome-calendar",
    "tooltip": false
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "group/expand-icons",
      "tray",
      "power-profiles-daemon"
    ]
  },
  "group/expand-icons": {
    "orientation": "inherit",
    "modules": [
      "custom/expand-icon#horizontal",
      "custom/expand-icon#vertical"
    ]
  },
  "custom/expand-icon#horizontal": {
    "format": "",
    "tooltip": false,
    "on-scroll-up": "",
    "on-scroll-down": "",
    "on-scroll-left": "",
    "on-scroll-right": ""
  },
  "custom/expand-icon#vertical": {
    "format": "",
    "rotate": 270,
    "tooltip": false,
    "on-scroll-up": "",
    "on-scroll-down": "",
    "on-scroll-left": "",
    "on-scroll-right": ""
  },
  "battery": {
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "bat: {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "interval": 3,
    "tooltip": false,
    "tooltip-format": "Battery: {capacity}%",
    "on-click": "bash ~/.config/sway/scripts/power_profile.sh",
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  "power-profiles-daemon": {
    "format": "prf: {profile}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "󰓅",
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰾆"
    }
  },
  "custom/updates": {
    "format": "upd: {}",
    "return-type": "json",
    "format-icons": {
      "has-updates": "󱍷",
      "updated": "󰂪"
    },
    "on-click": "alacritty --class float -e bash ~/.config/sway/scripts/update_system.sh",
    "exec-if": "which waybar-module-pacman-updates",
    "exec": "waybar-module-pacman-updates --interval-seconds 5 --network-interval-seconds 300"
  },
  "network": {
    "format": "net: {signalStrength}%",
    "format-disconnected": "net: none",
    "tooltip": true,
    "tooltip-format": "{essid} ({signalStrength}%)",
    "on-click": "alacritty --class float -e nmtui",
    "format-icons": [
      "󰤯 ",
      "󰤟 ",
      "󰤢 ",
      "󰤥 ",
      "󰤨 "
    ]
  },
  "pulseaudio": {
    "format": "vol: {volume}%",
    "format-muted": "vol: 0%",
    "on-click": "pamixer --toggle-mute",
    "on-click-right": "pavucontrol",
    "tooltip": false,
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "custom/separator": {
    "format": "|",
    "tooltip": false
  },
  "mpd": {
    "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
    "format-disconnected": "Disconnected ",
    "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
    "unknown-tag": "N/A",
    "interval": 5,
    "consume-icons": {
      "on": " "
    },
    "random-icons": {
      "off": "<span color=\"#f53c3c\"></span> ",
      "on": " "
    },
    "repeat-icons": {
      "on": " "
    },
    "single-icons": {
      "on": "1 "
    },
    "state-icons": {
      "paused": "",
      "playing": ""
    },
    "tooltip-format": "MPD (connected)",
    "tooltip-format-disconnected": "MPD (disconnected)"
  }
}

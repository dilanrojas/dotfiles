// -*- mode: jsonc -*-
{
  // "layer": "top",
  "reload_style_on_change": true,
  // "position": "bottom",
  "height": 35,
  // "width": 1280,
  "spacing": 4,
  "modules-left": [
    "sway/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "custom/updates",
    "custom/separator",
    "sway/scratchpad",
    "sway/language",
    "power-profiles-daemon",
    "custom/separator",
    "network",
    "pulseaudio",
    "battery",
    "custom/power"
  ],
  // Modules configuration
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{icon}",
    "format-icons": {
      "1": "I",
      "2": "II",
      "3": "III",
      "4": "IV",
      "5": "V",
      "6": "VI",
      "7": "VII",
      "8": "VIII",
      "9": "IX",
      "10": "X",
      //"urgent": "",
      "focused": "O"
    },
    "persistent-workspaces": {
      "1": [
        "eDP-1"
      ],
      "2": [
        "eDP-1"
      ],
      "3": [
        "eDP-1"
      ],
      "4": [
        "eDP-1"
      ],
      "5": [
        "eDP-1"
      ],
      "6": [
        "HDMI-A-1"
      ],
      "7": [
        "HDMI-A-1"
      ],
      "8": [
        "HDMI-A-1"
      ],
      "9": [
        "HDMI-A-1"
      ],
      "10": [
        "HDMI-A-1"
      ]
    }
  },
  "sway/scratchpad": {
    "format": "{icon} {count}",
    "show-empty": false,
    "format-icons": [
      "",
      ""
    ],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "tray": {
    "icon-size": 21,
    "spacing": 14
  },
  "clock": {
    "format": "{:%b %d  %I:%M %p}",
    "on-click-right": "gnome-calendar",
    "on-click": "swaync-client -t -sw",
    "tooltip": false
  },
  "battery": {
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{icon}  {capacity}%",
    "format-charging": " {icon} {capacity}%",
    "format-plugged": " {icon} {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "interval": 3,
    "tooltip": false,
    "tooltip-format": "Battery: {capacity}%"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "󰓅",
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰾆"
    }
  },
  "custom/updates": {
    "format": "󰒙 {}",
    "return-type": "json",
    "format-icons": {
      "has-updates": "󱍷",
      "updated": "󰂪"
    },
    "on-click": "alacritty --class float -e bash ~/.config/hypr/scripts/update_system.sh",
    "exec-if": "which waybar-module-pacman-updates",
    "exec": "waybar-module-pacman-updates --interval-seconds 5 --network-interval-seconds 300"
  },
  "network": {
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "  {ipaddr}/{cidr}",
    "tooltip-format": "  {ifname} via {gwaddr}",
    "format-linked": "  {ifname} (No IP)",
    "format-disconnected": "󰤮 ",
    "tooltip": false,
    "on-click": "alacritty --class float -e nmtui",
    "format-icons": [
      "󰤯 ",
      "󰤟 ",
      "󰤢 ",
      "󰤥 ",
      "󰤨 "
    ]
  },
  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon} ",
    "format-bluetooth": "󰂰",
    "format-bluetooth-muted": "󰂰",
    "format-muted": " ",
    "format-source": " {volume}%",
    "format-source-muted": " ",
    "on-click": "pamixer --toggle-mute",
    "on-click-right": "pavucontrol",
    "tooltip-format": "{volume}%",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "tooltip": false
  },
  "custom/separator": {
    "format": "|",
    "tooltip": false
  },
  "custom/power": {
    "format": " ",
    "on-click": "wlogout",
    "tooltip": false
  },
  "custom/menu": {
    "format": "",
    "on-click": "alacritty --class float -e nvim ~/.config/hypr/hyprland.conf",
    "tooltip": false
  }
}
